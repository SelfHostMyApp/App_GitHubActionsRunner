# GitHub Personal Access Token with repo and workflow permissions
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# How often to poll GitHub API for queued jobs (seconds)
POLL_INTERVAL=30

# Docker image for ephemeral runners
RUNNER_IMAGE=gh-ephemeral-runner:latest

# Docker network for runners
DOCKER_NETWORK=github-runners

# Resource limits for each ephemeral runner
CONTAINER_CPU=2
CONTAINER_MEMORY=2g
