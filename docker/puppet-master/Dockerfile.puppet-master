# Dockerfile.puppet-master
# The "Puppet Master" - orchestrates ephemeral GitHub Actions runners
#
# This container:
# - Has access to the Docker/Podman socket
# - Reads config.json for per-repo/org runner settings
# - Polls GitHub API for queued jobs
# - Spawns ephemeral runner containers when jobs are detected
# - Cleans up completed runners
# - Never runs jobs itself - only orchestrates
#
# Compatible with both Docker and Podman runtimes

FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

# Install minimal required packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    jq \
    gnupg \
    lsb-release \
    xxd \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (compatible with Podman socket too)
# We only need the CLI - the daemon runs on the host
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# Create config directory
RUN mkdir -p /config

# Copy the puppet master script
COPY puppet-master.sh /puppet-master.sh
RUN chmod +x /puppet-master.sh

# Default environment variables
ENV POLL_INTERVAL=30
ENV CONTAINER_NETWORK=github-runners
ENV CONFIG_FILE=/config/config.json

# The socket path is auto-detected, but can be overridden:
# Docker: /var/run/docker.sock
# Podman: /var/run/podman/podman.sock or /run/podman/podman.sock

ENTRYPOINT ["/puppet-master.sh"]
